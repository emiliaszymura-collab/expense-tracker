{
  "name": "blask",
  "productName": "Blask",
  "version": "0.1.0",
  "description": "Porównywarka cen kosmetyków — aplikacja desktopowa",
  "main": "main.js",
  "author": "Emilia Szymura",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pl.blask.app",
    "productName": "Blask",
    "files": [
      "main.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
